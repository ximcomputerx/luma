{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Custom commands are the Phase 2 set. No fs, store, dialog, http, shell, or opener permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "allow-preview-render",
    "allow-document-new",
    "allow-document-open",
    "allow-document-save",
    "allow-document-autosave",
    "allow-folder-open",
    "allow-folder-list",
    "allow-settings-get",
    "allow-settings-set",
    "allow-close-decision",
    "allow-diagnostics-export",
    "allow-document-close",
    "allow-document-focus",
    "allow-image-paste",
    "allow-export-html",
    "allow-export-pdf",
    "allow-pdf-preview",
    "allow-fonts-list"
  ]
}
